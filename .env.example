# Local controller and dashboard URLs. Never commit a populated .env file.
BACKITUP_ENVIRONMENT=development
# Local development default. Production should use the Supabase Postgres SSL
# connection string from Dashboard -> Connect (the app normalizes postgresql://
# to the bundled psycopg 3 driver automatically).
BACKITUP_DATABASE_URL=postgresql+psycopg://backitup:backitup@127.0.0.1:54322/backitup
BACKITUP_PUBLIC_URL=http://localhost:8000
BACKITUP_FRONTEND_URL=http://127.0.0.1:5173

# Supabase project URL and publishable key. Configure GitHub OAuth in Supabase Auth.
BACKITUP_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
BACKITUP_SUPABASE_PUBLIC_URL=https://YOUR_PROJECT.supabase.co
BACKITUP_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Supabase Dashboard -> Authentication -> JWT Keys -> JWKS URL.
BACKITUP_SUPABASE_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json

# BackItUp source GitHub App: read-only repository permissions.
BACKITUP_SOURCE_APP_ID=
BACKITUP_SOURCE_APP_SLUG=
BACKITUP_SOURCE_CLIENT_ID=
BACKITUP_SOURCE_CLIENT_SECRET=
BACKITUP_SOURCE_WEBHOOK_SECRET=
# Place its PEM file at secrets/source-app.pem.

# BackItUp recovery GitHub App: repository creation and contents/workflows write.
BACKITUP_RECOVERY_APP_ID=
BACKITUP_RECOVERY_APP_SLUG=
BACKITUP_RECOVERY_CLIENT_ID=
BACKITUP_RECOVERY_CLIENT_SECRET=
# Place its PEM file at secrets/recovery-app.pem.

# Required for BackItUp Cloud. Users never enter or receive these credentials.
BACKITUP_MANAGED_R2_ACCOUNT_ID=
BACKITUP_MANAGED_R2_BUCKET=
BACKITUP_MANAGED_R2_ACCESS_KEY_ID=
BACKITUP_MANAGED_R2_SECRET_ACCESS_KEY=
